# Generate a private .env using tools/init-env.ps1; never commit the real file.
MYSQL_ROOT_PASSWORD=replace-with-generated-root-password
DB_PASSWORD=replace-with-generated-app-password
JWT_SECRET=replace-with-generated-signing-secret
BACKEND_PORT=18081
# Safe local capture: Mailpit retains messages instead of delivering externally.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=reminders@example.test
MAX_RETRIES=3
RETRY_BASE_SECONDS=30
RETRY_CAP_SECONDS=3600
SCHEDULER_POLL_MS=10000
SCHEDULER_LEASE_SECONDS=120
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
